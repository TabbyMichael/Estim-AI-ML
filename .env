# Application Settings
APP_NAME=Estim AI Platform
DEBUG=true
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql://estim:estim@localhost:5432/estim_ai
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# Security
SECRET_KEY=change_me_in_production_use_strong_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Odoo Integration
ODOO_URL=https://odoo.estim.co.tz
ODOO_DB=production
ODOO_USERNAME=api_user
ODOO_PASSWORD=change_me
ODOO_SYNC_INTERVAL_MINUTES=15

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=estim-ai

# Object Storage (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=estimadmin
S3_SECRET_KEY=estimadmin123
S3_BUCKET=estim-ai-artifacts
S3_REGION=us-east-1

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_TIMEOUT=300

# Monitoring
PROMETHEUS_ENABLED=true
METRICS_PORT=9090

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_CORRELATION_ID_ENABLED=true

# Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@estim.co.tz
SMTP_TLS=true

# Feature Flags
ENABLE_PROCUREMENT_AI=true
ENABLE_COST_FORECASTING=false
ENABLE_INVENTORY_AI=false
ENABLE_MAINTENANCE_AI=false
ENABLE_PROJECT_RISK_AI=false
ENABLE_VISUAL_INSPECTION=false
ENABLE_DOCUMENT_INTELLIGENCE=false

# Model Configuration
PROCUREMENT_ANOMALY_MODEL_VERSION=v1
PROCUREMENT_ANOMALY_THRESHOLD=0.7
COST_FORECAST_MODEL_VERSION=v1
INVENTORY_FORECAST_MODEL_VERSION=v1

# Data Retention
AUDIT_LOG_RETENTION_DAYS=365
EVENT_OUTBOX_RETENTION_DAYS=30
MODEL_ARTIFACT_RETENTION_DAYS=90
