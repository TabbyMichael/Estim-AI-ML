# Staging Environment Configuration
# Copy this file to .env.staging and fill in your values

# Database
STAGING_DB_PASSWORD=your_staging_db_password

# Redis
STAGING_REDIS_PASSWORD=your_staging_redis_password

# MinIO / Object Storage
STAGING_MINIO_ACCESS_KEY=your_staging_minio_access_key
STAGING_MINIO_SECRET_KEY=your_staging_minio_secret_key

# Security
STAGING_SECRET_KEY=your_staging_secret_key_change_in_production

# Grafana
STAGING_GRAFANA_PASSWORD=your_staging_grafana_password

# Odoo Integration (optional)
STAGING_ODOO_URL=https://odoo.staging.estim.ai
STAGING_ODOO_DB=estim_staging
STAGING_ODOO_USERNAME=odoo_user
STAGING_ODOO_PASSWORD=odoo_password